# Normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly set for the agent-memory files
agent-memory/** text eol=lf

# Raw evidence receipts and candidate evidence logs are byte-addressed by SHA-256
# (in the manifest and in the evidence JSON respectively).
# Keep Windows stdout/stderr bytes stable across checkout and review.
docs/implementation/lite-closeout/evidence/**/*.txt binary
