# AgentOS — Environment Configuration
# Copy to .env and fill in your values.

## Execution Mode
# Set to "true" to use mock outputs instead of real agent CLIs.
# When false (default), missing or failing CLIs will fail the pipeline
# rather than silently falling back to mock output.
AGENTOS_FORCE_MOCK=false

## CLI Paths
# Path or command name for each agent CLI.
# Default: assume the command is in PATH (e.g. "codex", "kimi", "opencode")
# Override with an absolute path if needed.
# AGENTOS_CODEX_CLI=codex
# AGENTOS_KIMI_CLI=kimi
# AGENTOS_OPENCODE_CLI=opencode

## Kimi API Key (optional)
# When set, Kimi Worker uses API Key authentication instead of managed OAuth.
# Keep the real value in your user environment; never commit it to this file.
# AGENTOS_KIMI_API_KEY=
# AGENTOS_KIMI_BASE_URL=https://api.kimi.com/coding/v1

## Model Selection
# AGENTOS_KIMI_MODEL=kimi-code/kimi-for-coding
# AGENTOS_OPENCODE_MODEL=deepseek/deepseek-v4-flash

## Inactivity Timeout
# Optional inactivity timeout in milliseconds. Empty, 0, or null disables it (default).
# A running Agent is only stopped when it produces no stdout/stderr activity for this duration.
# AGENTOS_AGENT_TIMEOUT=0

## Server
# PORT=3000
# NEXT_PUBLIC_API_URL=http://localhost:3000
